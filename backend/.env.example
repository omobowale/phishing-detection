# "development" (default) or "production". In production, startup refuses to
# boot if SECRET_KEY is still the insecure code default -- see app/main.py.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./phishing_detection.db
# generate a real one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CLASSIFIER_BACKEND=rule_based
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
