# "development" (default) or "production". In production, startup refuses to
# boot if SECRET_KEY is still the insecure code default -- see app/main.py.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./phishing_detection.db
# generate a real one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# "rule_based" (default, for both) needs no trained model files and always
# works, so a fresh checkout / CI keeps running without ml/saved_models/*.joblib
# present. Set to "trained" once you've run the matching training script to use
# it instead -- these are independent because the two models have very
# different maturity: the trained URL model (train_url_classifier.py) has a
# known failure mode (misclassifies ordinary bare domains like "google.com",
# see ml/README.md section 5) and is NOT recommended as "trained" yet; the
# trained email model (train_email_classifier.py) has no equivalent known
# issue and meets every spec target (see ml/README_EMAIL.md).
URL_CLASSIFIER_BACKEND=rule_based
EMAIL_CLASSIFIER_BACKEND=rule_based
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
